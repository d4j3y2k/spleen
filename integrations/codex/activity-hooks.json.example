{
  "description": "Spleen local lifecycle observations. Metadata only; no approval decisions or model context. Review and trust normally.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/absolute/path/to/Spleen.app/Contents/MacOS/Spleen\" --activity-event codex --data-dir \"/absolute/path/to/spleen-data\"",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/absolute/path/to/Spleen.app/Contents/MacOS/Spleen\" --activity-event codex --data-dir \"/absolute/path/to/spleen-data\"",
            "timeout": 1
          }
        ]
      }
